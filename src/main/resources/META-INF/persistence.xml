<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- Anwendungsverwaltete Persistence Unit (siehe EntityManagerProducer) -->
    <persistence-unit name="pressflowPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>de.pressflow.model.User</class>
        <class>de.pressflow.model.PressRelease</class>
        <class>de.pressflow.model.Comment</class>
        <class>de.pressflow.model.StatusChange</class>

        <properties>
            <!-- Verbindung zur MySQL-Datenbank (Zugangsdaten siehe sql/create-database.sql) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/pressflow?useSSL=false&amp;serverTimezone=Europe/Berlin&amp;allowPublicKeyRetrieval=true"/>
            <property name="jakarta.persistence.jdbc.user" value="pressflow"/>
            <property name="jakarta.persistence.jdbc.password" value="pressflow"/>

            <!-- Tabellen werden beim Start automatisch angelegt bzw. ergänzt -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>

            <!-- Vermeidet Initialisierungsprobleme zwischen Hibernate, CDI und TomEE -->
            <property name="hibernate.delay_cdi_access" value="true"/>
            <property name="tomee.jpa.factory.lazy" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
